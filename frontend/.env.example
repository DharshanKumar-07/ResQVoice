# The browser publishes only RTC audio; Agora Conversational AI owns VAD/ASR/TTS.
# Local development: http://localhost:8000
# Hosted frontend: https://resqvoice-api.onrender.com (the stable Render URL)
VITE_BACKEND_URL=http://localhost:8000
VITE_AGORA_AGENT_UID=1000
# Local microphone activity indicator only; Agora owns actual VAD/transcription.
VITE_SPEECH_ACTIVITY_THRESHOLD=0.025
VITE_SPEECH_SILENCE_GAP_MS=500
