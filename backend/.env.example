# Server-only provider credentials
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Audio transcription and extraction tuning
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_REQUESTS_PER_MINUTE=18
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
EXTRACTION_BATCH_MAX_WORDS=75
EXTRACTION_BATCH_MAX_DURATION_SECONDS=30
EXTRACTION_BATCH_MAX_WAIT_SECONDS=20

# Local infrastructure
# If port 5432 is occupied, set POSTGRES_HOST_PORT in the repository .env and
# use the same port here (for example localhost:5433).
DATABASE_URL=postgresql://resqvoice:resqvoice_password@localhost:5432/resqvoice_db
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Agora Conversational AI REST credentials (never expose these to Vite/browser code)
AGORA_CUSTOMER_ID=your-agora-customer-id
AGORA_CUSTOMER_SECRET=your-agora-customer-secret
# Public HTTPS URL/tunnel through which Agora can reach this FastAPI service
AGORA_PUBLIC_BASE_URL=https://resqvoice.example.com
AGORA_WEBHOOK_SECRET=replace-with-a-long-random-bearer-secret
AGORA_CONVERSATIONAL_AI_BASE_URL=https://api.agora.io/api/conversational-ai-agent/v2/projects
AGORA_AGENT_IDLE_TIMEOUT_SECONDS=300
AGORA_VALIDATE_PUBLIC_URL=true
AGORA_ASR_VENDOR=ares
AGORA_ASR_LANGUAGE=en-US
AGORA_VAD_SPEECH_THRESHOLD=0.5
AGORA_VAD_SILENCE_MS=600
AGORA_LLM_MODEL=resqvoice-incident-brain
# Agora-managed MiniMax credentials; tts JSON only supplies voice/audio overrides.
AGORA_AGENT_PRESET=minimax_speech_2_6_turbo
AGORA_TTS_CONFIG_JSON={"params":{"voice_setting":{"voice_id":"English_captivating_female1","speed":1.0},"audio_setting":{"sample_rate":44100}}}
# Set true only for local UI/backend tests that must not create a cloud agent.
MOCK_AGORA_AGENT=false

# Voice intervention policy
INTERVENTION_MIN_SEVERITY=HIGH
INTERVENTION_COOLDOWN_SECONDS=120
INTERVENTION_EXPIRATION_SECONDS=300
INTERVENTION_MAX_PER_WINDOW=3
INTERVENTION_WINDOW_SECONDS=300
INTERVENTION_SPEECH_GUARD_SECONDS=2
INTERVENTION_SCAN_INTERVAL_SECONDS=30
# Every intervention below is freshly composed by Gemini from current Incident State.
GEMINI_INTERVENTION_MODEL=gemini-3.5-flash-lite
INTERVENTION_PERIODIC_SUMMARY_SECONDS=300
# `interrupt` uses Agora Speak priority=INTERRUPT; `queue` makes all speech APPEND.
INTERVENTION_HIGH_PRIORITY_MODE=interrupt
INTERVENTION_HIGH_PRIORITY_TRIGGERS=CONFLICT_DETECTED,STALE_CRITICAL_CLAIM
